<% layout("/layouts/boilerplate")%>

<body>
   
    <style>
      #filters{
        display: flex;
        flex-wrap: wrap;
        align-items: center;
      }

      .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
      }

      .filter:hover{
        opacity: 1;
        cursor: pointer;
      }

      .filter p{
        font-size: 0.8rem;
      }

      .tax-info{
        display: none;
      }

      .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        margin-left: 3rem;
        display: flex;
        align-items: center;
      }
    </style>

    <% if (searchTerm && searchTerm.trim() !== '') { %>
      <div class="mt-3">
        <h5>Showing results for: "<%= searchTerm %>"</h5>
        <% if (allListings.length === 0) { %>
          <p class="text-muted">No listings found matching "<%= searchTerm %>". Try different keywords.</p>
        <% } else { %>
          <p class="text-muted"><%= allListings.length %> listing(s) found</p>
        <% } %>
      </div>
    <% } %>

    <div id="filters">
      <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></i></div>
          <p>Rooms</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic Cities</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
      </div>
      <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castels</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>Amazing Pools</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
          <p>Campgrounds</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p>
      </div>
      <div class="filter">
        <div><i class="fa-regular fa-snowflake"></i></div>
          <p>Artic</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-igloo"></i></i></div>
          <p>Domes</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
          <p>Boats</p>
      </div>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for(let listings of allListings) {%>
        <a href="/listings/<%=listings._id%>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%=listings.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b> <%= listings.title%></b>  <br>
                &#8377 <%=listings.price.toLocaleString("en-IN")%> / night
                <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
              </p>
            </div>
          </div>
        </a>
      <%}%> 

      <% if (allListings.length === 0) { %>
        <p class="text-center mt-5">No listings found.</p>
      <% } %>
    </div>

    <script>
      // Tax toggle
      let taxswitch = document.getElementById("switchCheckDefault");
      taxswitch.addEventListener("click", () => {
        let tax_info = document.getElementsByClassName("tax-info");
        for (let info of tax_info) {
          info.style.display = (info.style.display !== "inline") ? "inline" : "none";
        }
      });

      // Fix for Browser Back Button - Force sync with current URL
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
          // Page was loaded from cache (back/forward button)
          window.location.reload();
        }
      });
    </script>

</body>